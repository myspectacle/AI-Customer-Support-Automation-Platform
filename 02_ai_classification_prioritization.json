    {
      "id": "57415468-daac-4d7d-a627-19a951a05a34",
      "name": "OpenAI - Classify Ticket",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.6,
      "position": [
        680,
        300
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a support-ticket triage assistant. Read the ticket and return STRICT JSON only, no prose, with keys: category (Billing|Technical|Account|General), priority (P1|P2|P3), sentiment (Positive|Neutral|Negative), summary (max 20 words)."
            },
            {
              "role": "user",
              "content": "=Subject: {{$json.subject}}\nMessage: {{$json.message}}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CRED_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "id": "aedb9219-effd-4ab7-93f7-f058589a2267",
      "name": "Parse AI Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.message?.content || $input.first().json.content || '{}';\nlet parsed;\ntry {\n  const clean = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = { category: 'General', priority: 'P3', sentiment: 'Neutral', summary: 'Could not parse AI response' };\n}\nconst ticket = $('Google Sheets - Get New Tickets').item.json;\nreturn [{\n  json: {\n    ...ticket,\n    category: parsed.category,\n    priority: parsed.priority,\n    sentiment: parsed.sentiment,\n    ai_summary: parsed.summary,\n    status: 'Classified'\n  }\n}];"
      }
    },
    {
      "id": "bd065c44-da48-4dc9-a076-82a293054677",
      "name": "Google Sheets - Update Classification",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Tickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "ticket_id"
          ],
          "value": {
            "ticket_id": "={{$json.ticket_id}}",
            "category": "={{$json.category}}",
            "priority": "={{$json.priority}}",
            "sentiment": "={{$json.sentiment}}",
            "ai_summary": "={{$json.ai_summary}}",
            "status": "={{$json.status}}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CRED_ID",
          "name": "Google Sheets account"
        }
      }
    }
  ],
