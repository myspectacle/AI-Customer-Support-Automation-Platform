      "typeVersion": 2.1,
      "position": [
        900,
        180
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "senior.agent@company.com",
        "subject": "=P1 Critical Ticket Escalation - {{$json.ticket_id}}",
        "message": "=A P1 critical support ticket needs senior review and approval.<br><br>Ticket ID: {{$json.ticket_id}}<br>Customer: {{$json.customer_name}}<br>Category: {{$json.category}}<br>Summary: {{$json.ai_summary}}<br><br>Please review and assign a senior agent.",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CRED_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "6ada1abb-4414-4205-b546-2991d48d9d79",
      "name": "Assign Agent (Round Robin)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        420
      ],
      "parameters": {
        "jsCode": "const agents = ['agent1@company.com','agent2@company.com','agent3@company.com'];\nreturn items.map((item, i) => {\n  const idx = Math.floor(Math.random() * agents.length);\n  item.json.assigned_agent = agents[idx];\n  item.json.status = 'Assigned';\n  return item;\n});"
      }
    },
