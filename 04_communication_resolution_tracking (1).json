      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "update-ticket-status",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "0da7d150-7806-46a9-84da-eb1bb3e3e857",
      "name": "IF - Status is Resolved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "92c2f75d-11e0-4897-8ecc-14a6b2dff0d2",
              "leftValue": "={{$json.body.status}}",
              "rightValue": "Resolved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "dadad4ef-f803-4997-93c3-9ebac1f7989f",
      "name": "Gmail - Send Resolution Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        680,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$json.body.customer_email}}",
        "subject": "=Your ticket {{$json.body.ticket_id}} has been resolved",
        "message": "=Hi {{$json.body.customer_name}},<br><br>Good news \u2014 your support ticket <b>{{$json.body.ticket_id}}</b> has been marked as resolved.<br><br>Resolution notes: {{$json.body.resolution_notes}}<br><br>We'd love your feedback \u2014 you'll receive a short survey shortly.<br><br>Support Team",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CRED_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "3074ad49-6632-4b3c-bb4e-fc01e1d93242",
      "name": "Gmail - Send Status Update Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        680,
        420
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$json.body.customer_email}}",
        "subject": "=Update on your ticket {{$json.body.ticket_id}}",
        "message": "=Hi {{$json.body.customer_name}},<br><br>Your ticket status has been updated to: <b>{{$json.body.status}}</b>.<br><br>Agent notes: {{$json.body.resolution_notes}}<br><br>Support Team",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CRED_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "13ca2edf-a156-4879-81ee-8d3c3c40f918",
