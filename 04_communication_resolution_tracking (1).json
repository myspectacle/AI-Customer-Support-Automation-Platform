      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1010,
        300
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Tickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "ticket_id"
          ],
          "value": {
            "ticket_id": "={{$json.body.ticket_id}}",
            "status": "={{$json.body.status}}",
            "resolution_notes": "={{$json.body.resolution_notes}}",
            "resolved_at": "={{$json.body.status === 'Resolved' ? $now.toISO() : ''}}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CRED_ID",
          "name": "Google Sheets account"
        }
      }
    },
