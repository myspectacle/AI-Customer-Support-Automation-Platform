    {
      "id": "c24a5381-dbc0-492b-8e5e-463f86d83dc6",
      "name": "Compute Weekly Analytics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        460
      ],
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst total = rows.length;\nconst resolved = rows.filter(r => r.status === 'Resolved').length;\nconst byPriority = rows.reduce((acc, r) => {\n  acc[r.priority || 'Unclassified'] = (acc[r.priority || 'Unclassified'] || 0) + 1;\n  return acc;\n}, {});\nconst byCategory = rows.reduce((acc, r) => {\n  acc[r.category || 'Unclassified'] = (acc[r.category || 'Unclassified'] || 0) + 1;\n  return acc;\n}, {});\nreturn [{\n  json: {\n    total_tickets: total,\n    resolved_tickets: resolved,\n    resolution_rate: total ? ((resolved / total) * 100).toFixed(1) + '%' : '0%',\n    by_priority: JSON.stringify(byPriority),\n    by_category: JSON.stringify(byCategory),\n    generated_at: new Date().toISOString()\n  }\n}];"
      }
    },
    {
      "id": "f5996c34-d80d-45dd-ba1f-0827b96d2233",
      "name": "Gmail - Send Weekly Report to Manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        900,
        460
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "support-manager@company.com",
        "subject": "=Weekly Support Analytics Report - {{$now.format('yyyy-MM-dd')}}",
        "message": "=<h3>Weekly Support Summary</h3><ul><li>Total tickets: {{$json.total_tickets}}</li><li>Resolved: {{$json.resolved_tickets}}</li><li>Resolution rate: {{$json.resolution_rate}}</li><li>By priority: {{$json.by_priority}}</li><li>By category: {{$json.by_category}}</li></ul>",
        "options": {
          "appendAttribution": false
        }
      },
